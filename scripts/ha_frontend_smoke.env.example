# Copy to a local, ignored env file and fill in values for your HA test instance.
# Example:
#   set -a
#   . ./ha_frontend_smoke.env
#   set +a
#   python scripts/smoke_ha_frontend.py

HA_SMOKE_URL=http://homeassistant.local:8123
HA_SMOKE_USER=homeassistant-user
HA_SMOKE_PASSWORD=replace-me
HA_SMOKE_CHROME=/usr/bin/google-chrome

# Optional discovery mode:
#  - auto (default): discover snapshot inventories from live HA states and derive button IDs
#  - off: only use the explicit entity IDs below
HA_SMOKE_DISCOVERY_MODE=auto

# Optional filters for discovery (case-insensitive substring):
#   HA_SMOKE_TARGET_FILTER="shared drive"
#   HA_SMOKE_SNAPSHOT_ENTITY_PREFIX="unifi_unas_"
#
# If discovery mode is on, empty values will fall back to auto-selection:
# first "ok" snapshot inventory for supported target checks and first unsupported
# inventory for negative checks.

# Optional explicit IDs for deterministic checks.
# Leave these empty if you want dynamic discovery.
# HA_SMOKE_SNAPSHOT_OK_INVENTORY_ENTITY=
# HA_SMOKE_SNAPSHOT_UNSUPPORTED_INVENTORY_ENTITY=
# HA_SMOKE_SNAPSHOT_OK_BUTTON_ENTITY=
# HA_SMOKE_SNAPSHOT_UNSUPPORTED_BUTTON_ENTITY=
# Backward-compatible alias for the unsupported button expectation:
# HA_SMOKE_SNAPSHOT_UNAVAILABLE_BUTTON_ENTITY=

# Optional expectations. Defaults shown here match the normal HA TEST setup.
HA_SMOKE_SNAPSHOT_OK_INVENTORY_STATUS=ok
HA_SMOKE_SNAPSHOT_OK_INVENTORY_SOURCE=inventory_total
HA_SMOKE_SNAPSHOT_UNSUPPORTED_INVENTORY_STATUS=unsupported
HA_SMOKE_SNAPSHOT_UNSUPPORTED_INVENTORY_SOURCE=snapshot_settings_total_count
HA_SMOKE_SNAPSHOT_OK_BUTTON_STATE=available
# When no unsupported snapshot target is discovered, checks are skipped unless
# this flag is set.
HA_SMOKE_REQUIRE_UNSUPPORTED=false
HA_SMOKE_SNAPSHOT_UNSUPPORTED_BUTTON_STATE=missing

# Optional execution/debug knobs.
HA_SMOKE_CONNECT_TIMEOUT_MS=90000
HA_SMOKE_NAV_TIMEOUT_MS=30000
HA_SMOKE_HEADLESS=true
HA_SMOKE_SKIP_LOGIN=false
# Use the Home Assistant auth-flow API to create a short-lived API token from
# HA_SMOKE_USER/HA_SMOKE_PASSWORD, then read live state through /api/states.
# Disable only when you explicitly want browser-form login behavior.
HA_SMOKE_AUTH_FLOW_TOKEN=true
# Optional API token for automated reads on setups with external OAuth/Authorize flow.
# HA_SMOKE_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
# Optional alternative names:
# HA_SMOKE_LONG_LIVED_TOKEN=
# HA_LONG_LIVED_TOKEN=
# LONG_LIVED_TOKEN=
HA_SMOKE_CHROME_USER_DATA_DIR=
# Optional override for Chromium launch arguments (comma-separated).
# HA_SMOKE_CHROME_ARGS=--no-sandbox,--disable-dev-shm-usage
# HA_SMOKE_SCREENSHOTS_DIR=/tmp/ha_smoke_screenshots
